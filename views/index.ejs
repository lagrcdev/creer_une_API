<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <title>Port de Plaisance Russell</title>
</head>
<body>
  <h1>Port de Plaisance Russell</h1>
  <p>Application de gestion des reservations de catways pour la capitainerie du port de Russell.</p>

  <% if (erreur) { %>
    <p style="color:red"><%= erreur %></p>
  <% } %>

  <h2>Connexion</h2>
  <form method="post" action="/login">
    <input type="email" name="email" placeholder="Email" required>
    <input type="password" name="password" placeholder="Mot de passe" required>
    <button type="submit">Se connecter</button>
  </form>

  <p><a href="/documentation">Documentation de l'API</a></p>
</body>
</html>
